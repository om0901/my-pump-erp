{
  "name": "mypump",
  "private": true,
  "version": "1.0.0",
  "description": "MY PUMP - Shital Petroleum Daily Sales & Cash Reconciliation ERP System",
  "author": "Shital Petroleum",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.shitalpetroleum.mypump",
    "productName": "MY PUMP",
    "copyright": "Copyright © 2026 Shital Petroleum - Developed By OM Raval And Instructed By Shaileshkumar Raval",
    "directories": {
      "output": "build_output"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MY PUMP Setup.exe",
      "shortcutName": "MY PUMP"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
